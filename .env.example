# InsureCRM configuration. Copy to .env and fill in. Never commit .env.
# See docs/OPERATIONS.md for what each setting does and how to generate secrets.

# ── Required on a real server ──
APP_ENV=development              # set to "production" on a real server: it then refuses to start without the secrets below
SESSION_SECRET=                    # long random string; changing it signs everyone out
AUDIT_SIGNING_KEY=                 # long random string; never change after go-live
CREDENTIAL_ENCRYPTION_KEY=         # Fernet key; encrypts stored integration credentials
OAUTH_STATE_SECRET=                # long random string; protects Meta/Google/LinkedIn connection

# ── Storage ──
DATABASE_URL=                      # postgresql://user:password@host:5432/insurecrm — empty uses local JSON files
IDENTITY_STORE_PATH=crm_identity.json
TENANT_ROOT=crm_tenants
DOCUMENT_ROOT=crm_documents
BACKUP_ROOT=crm_backups
OBJECT_STORAGE_BUCKET=             # S3/MinIO bucket for documents (production)
OBJECT_STORAGE_ENDPOINT_URL=       # e.g. http://minio:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Document scanning (production) ──
CLAMAV_HOST=
CLAMAV_PORT=3310

# ── Scheduler ──
ENABLE_REMINDER_SCHEDULER=1        # 1 = run inside the web server; 0 when crm_worker.py runs separately
SCHEDULER_INTERVAL_SECONDS=60

# ── Sessions and limits ──
SESSION_TTL_SECONDS=28800
WEBHOOK_RATE_LIMIT=120

# ── Advertising lead sources (only if you connect them) ──
META_CLIENT_ID=
META_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ── Optional reporting assistant ──
OPENROUTER_API_KEY=
ADVISOR_MODEL=

# ── Docker Compose stack ──
POSTGRES_PASSWORD=
MINIO_ROOT_USER=insurecrm-storage
MINIO_ROOT_PASSWORD=
BACKUP_RETENTION_DAYS=30

# Development only — never on a real server:
# AUTH_DISABLED=1
