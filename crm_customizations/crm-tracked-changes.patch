+
+function recalculateAIScore() {
+  recalculatingScore.value = true
+  call('ai_crm.api.score_lead', { lead_name: props.leadId })
+    .then((r) => {
+      if (r && r.status === 'success') {
+        toast.success(__('Lead scored: {0}%', [Math.round(r.score)]))
+        document.reload?.()
+      } else {
+        toast.error(__('Failed to calculate AI score. Check if LM Studio is running.'))
+      }
+    })
+    .catch((err) => {
+      toast.error(err.messages?.[0] || __('Error calling AI model'))
+    })
+    .finally(() => {
+      recalculatingScore.value = false
+    })
+}
+
+function draftAIFollowup() {
+  draftingFollowup.value = true
+  call('ai_crm.api.recommend_action', { lead_name: props.leadId })
+    .then((r) => {
+      if (r && r.status === 'success') {
+        toast.success(__('Follow-up drafted successfully!'))
+        document.reload?.()
+      } else {
+        toast.error(__('Failed to draft follow-up. Check if LM Studio is running.'))
+      }
+    })
+    .catch((err) => {
+      toast.error(err.messages?.[0] || __('Error calling AI model'))
+    })
+    .finally(() => {
+      draftingFollowup.value = false
+    })
+}
+
+function useAIFollowup() {
+  let currentTab = tabs.value[tabIndex.value]
+  if (!['Emails', 'Comments', 'Activity'].includes(currentTab.name)) {
+    changeTabTo('Emails')
+  }
+  
+  nextTick(() => {
+    if (activities.value && activities.value.emailBox) {
+      activities.value.emailBox.show = true
+      nextTick(() => {
+        const emailBox = activities.value.emailBox
+        emailBox.newEmail = doc.value.suggested_followup_body
+        
+        if (emailBox.editor) {
+          emailBox.editor.subject = doc.value.suggested_followup_subject
+          if (emailBox.editor.editor) {
+            emailBox.editor.editor.commands.setContent(doc.value.suggested_followup_body)
+          }
+        }
+      })
+    }
+  })
+}
+
 </script>
